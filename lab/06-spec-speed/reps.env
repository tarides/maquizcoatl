# Passes per timed run, calibrated so that each timed fold lasts at
# least 10 s on the bench host (untimed calibration runs, run-id cal)
REPS_C=400000      # C oracle: compile, search, end to end (each REPS passes)
REPS_G=400000      # stack G: parse, search, end to end
REPS_ROCQ=60000    # extracted OCaml
REPS_LEAN=50000    # lake native build
REPS_WHY3=35000    # extracted OCaml (Z.t integers)
REPS_FSTAR=120000  # extracted OCaml (Z.t integers)
REPS_VM=3000       # Rocq vm_compute
REPS_NATIVE=4000   # Rocq native_compute
REPS_EVAL=5000     # Lean #eval
REPS_EXEC=5        # Why3 execute
REPS_NORM=5        # F* assert_norm (normaliser)
REPS_VERUS=250000  # Verus, compiled Rust (follow-up rows, series2.sh)
REPS_ISA=150000    # Isabelle export_code OCaml (Z.t integers)
REPS_VALUE=8000    # Isabelle value [code]
REPS_VALUE_L=100000 # Isabelle value [code], rerun (series4.sh): 8000 passes folded in under 10 s
