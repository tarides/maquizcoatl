# Experiment #6 milestone 2: passes per timed run, calibrated in untimed
# runs (CPUs 0-3) so that the shortest timed fold lasts at least 10 s
REPS_C_M2=30000      # C oracle (search fold about 0.36 ms per pass)
REPS_G_M2=9000       # stack G (search fold about 1.2 ms per pass)
REPS_WHY3_M2=1500    # Why3 extracted OCaml (about 7.7 ms per pass)
REPS_FSTAR_M2=2000   # F* extracted OCaml (about 6 ms per pass)
REPS_EXEC_M2=1       # why3 execute: one pass exceeds 10 s (about 45 s), so one pass is the fold
REPS_NORM_M2=1       # F* normaliser: one pass exceeds 10 s (about 0.18 s per case)
NAGREE_M2=1154       # emitted cases whose verdict equals the C library's (extracted drivers)
# Run 2 (calibrated in untimed runs on CPUs 0-15, updated S2: 1,243 cases,
# 1,184 emitted; the run 1 values above are kept for C, stack G, Why3, F*)
REPS_ROCQ_M2=1500    # Rocq extracted OCaml (about 8.4 ms per pass)
REPS_LEAN_M2=1500    # Lean lake native build (about 8.6 ms per pass)
REPS_VM_M2=80        # Rocq vm_compute (about 0.15 s per pass)
REPS_NATIVE_M2=300   # Rocq native_compute (about 0.045 s per pass)
REPS_EVAL_M2=100     # Lean #eval (about 0.14 s per pass)
NAGREE2_M2=1179      # emitted cases whose verdict equals the C library's (run 2)
