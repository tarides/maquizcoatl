/-
Experiment #6, milestone 2, Lean 4: executable semantics of experiment
#1's first subset S2 of Oniguruma f95747b, transcribed from stack G
(lab/06-spec-speed/g/g2.ml) into milestone 1's small-step machine
(lean/Spec.lean), as rocq/Spec2.v and fstar/Spec2.fst: pending items
plus an explicit list of backtracking points, one machine step per call
of `step`, fuel structural on `Nat`.  Commit points (atomic groups,
possessive quantifiers, lookaround bodies) are items that carry the
backtracking list to restore.  The case-fold map and the property ranges
come from the table module `Tables` (generated by cases/gen2.py), so
that T_spec measures the semantics alone.  No type indices or proofs in
executable definitions.
-/
import Tables

namespace Spec2
open Tables

inductive CSet where
  | cr (lo hi : Nat)
  | cp (p : Nat)
  | cnot (s : CSet)
  | cor (l : List CSet)
  | cand (a b : CSet)

inductive Anchor where
  | bol | eol | bufBeg | bufEnd | semiEnd | searchStart | wordB | notWordB

inductive Node where
  | eps
  | lit (bs : List Nat)
  | litI (f : List Nat)                          -- folded pattern string
  | cls (s : CSet)
  | clsI (s : CSet) (ms : List (List Nat))
  | cat (a b : Node)
  | alt (a b : Node)
  | rep (mn : Nat) (mx : Option Nat) (g : Bool) (a : Node)   -- mx none: infinite
  | atomic (a : Node)
  | ahead (neg : Bool) (a : Node)
  | behind (neg : Bool) (alts : List Node)
  | group (k : Nat) (a : Node)
  | bref (gs : List Nat) (ic : Bool)
  | anc (a : Anchor)
  deriving Inhabited

abbrev Caps := List (Nat × (Nat × Nat))

-- backtracking point: items, position, rest of the subject, captures
inductive Item where
  | node (n : Node)
  | close (k p : Nat)
  | iter (mn : Nat) (mx : Option Nat) (g : Bool) (a : Node) (c p0 : Nat) (c0 : Caps)
  | cut (bt : List (List Item × Nat × List Nat × Caps))
  | lookOk (bt : List (List Item × Nat × List Nat × Caps)) (p : Nat) (r : List Nat)
  | negFail (bt : List (List Item × Nat × List Nat × Caps))
  | atEnd (i : Nat)
  | bTry (alts : List Node) (j i : Nat)

abbrev Frame := List Item × Nat × List Nat × Caps

inductive State where
  | run (its : List Item) (pos : Nat) (rest : List Nat) (cs : Caps) (bt : List Frame)
  | matched (pos : Nat) (cs : Caps)
  | failed

-- UTF-8, as upstream/src/utf8.c (EncLen_UTF8, USE_RFC3629_RANGE)
def encLen (b : Nat) : Nat :=
  if b < 194 then 1 else if b < 224 then 2 else if b < 240 then 3
  else if b < 245 then 4 else 1

def take : Nat → List Nat → Option (List Nat × List Nat)
  | 0, l => some ([], l)
  | _ + 1, [] => none
  | n + 1, x :: t => match take n t with
    | some (a, r) => some (x :: a, r)
    | none => none

def leadMod : Nat → Nat
  | 2 => 32 | 3 => 16 | _ => 8

-- code point, encoded length, rest; none past the end (DATA_ENSURE)
def decode : List Nat → Option (Nat × Nat × List Nat)
  | [] => none
  | b :: t =>
    let l := encLen b
    if l == 1 then some (b, 1, t)
    else match take (l - 1) t with
      | some (tl, r) => some (tl.foldl (fun v d => v * 64 + d % 64) (b % leadMod l), l, r)
      | none => none

def pfx : List Nat → List Nat → Option (List Nat)
  | [], rest => some rest
  | x :: l, y :: r => if x == y then pfx l r else none
  | _ :: _, [] => none

mutual
def inCset (c : Nat) : CSet → Bool
  | .cr lo hi => lo ≤ c && c ≤ hi
  | .cp p => inProp p c
  | .cnot s => !(inCset c s)
  | .cor l => inCsets c l
  | .cand a b => inCset c a && inCset c b
def inCsets (c : Nat) : List CSet → Bool
  | [] => false
  | s :: t => inCset c s || inCsets c t
end

-- the remainder of `f` once `p` is stripped from its front
def strip : List Nat → List Nat → Option (List Nat)
  | [], f => some f
  | x :: p, y :: f => if x == y then strip p f else none
  | _ :: _, [] => none

-- a subject segment whose full case fold is exactly `f`: rest after it
def matchFold (rest : List Nat) : Nat → List Nat → Option (List Nat)
  | _, [] => some rest
  | 0, _ :: _ => none
  | n + 1, f@(_ :: _) =>
    match decode rest with
    | none => none
    | some (c, _, r) =>
      match strip (foldOf c) f with
      | some f' => matchFold r n f'
      | none => none

def foldString : List Nat → Nat → List Nat → List Nat
  | _, 0, acc => acc
  | l, n + 1, acc =>
    match decode l with
    | none => acc
    | some (c, _, r) => foldString r n (acc ++ foldOf c)

def setCap (k : Nat) (v : Nat × Nat) : Caps → Caps
  | [] => [(k, v)]
  | (k', w) :: t => if k' == k then (k, v) :: t else (k', w) :: setCap k v t

def lookup (k : Nat) : Caps → Option (Nat × Nat)
  | [] => none
  | (k', v) :: t => if k == k' then some v else lookup k t

def sameRefs : List Nat → Caps → Caps → Bool
  | [], _, _ => true
  | g :: t, a, b => lookup g a == lookup g b && sameRefs t a b

-- start of the character before `pos`, or none
def prevFrom : List Nat → Nat → Nat → Option Nat → Option Nat
  | [], _, _, last => last
  | b :: t, i, pos, last =>
    if pos ≤ i then last
    else prevFrom t (i + 1) pos (if 128 ≤ b && b < 192 then last else some i)

def prevPos (s : List Nat) (pos : Nat) : Option Nat := prevFrom s 0 pos none

def wordAt (rest : List Nat) : Bool :=
  match decode rest with
  | some (c, _, _) => inProp 12 c
  | none => false

def wordBefore (s : List Nat) (pos : Nat) : Bool :=
  match prevPos s pos with
  | some p => wordAt (s.drop p)
  | none => false

def isNl : List Nat → Bool
  | b :: _ => b == 10
  | [] => false

def anchorOk (s : List Nat) (ln : Nat) (a : Anchor) (pos : Nat) (rest : List Nat) : Bool :=
  match a with
  | .bol => pos == 0 || isNl (s.drop (pos - 1))
  | .eol => pos == ln || isNl rest
  | .bufBeg | .searchStart => pos == 0
  | .bufEnd => pos == ln
  | .semiEnd => pos == ln || (pos + 1 == ln && isNl rest)
  | .wordB => wordBefore s pos != wordAt rest
  | .notWordB => wordBefore s pos == wordAt rest

def backtrack : List Frame → State
  | [] => .failed
  | (its, pos, rest, cs) :: bt => .run its pos rest cs bt

-- the next iteration of a loop, or leaving it
def rep (mn : Nat) (mx : Option Nat) (g : Bool) (a : Node) (c : Nat) (k : List Item)
    (pos : Nat) (rest : List Nat) (cs : Caps) (bt : List Frame) : State :=
  let again := Item.node a :: Item.iter mn mx g a (c + 1) pos cs :: k
  let atMax : Bool := match mx with | some m => decide (m ≤ c) | none => false
  if c < mn then .run again pos rest cs bt
  else if atMax then .run k pos rest cs bt
  else if g then .run again pos rest cs ((k, pos, rest, cs) :: bt)
  else .run k pos rest cs ((again, pos, rest, cs) :: bt)

-- backreference: the groups in order, the first one set and matching
def bref (s : List Nat) : List Nat → Bool → Caps → List Nat → Option (List Nat)
  | [], _, _, _ => none
  | g :: t, ic, cs, rest =>
    match lookup g cs with
    | none => bref s t ic cs rest
    | some (x, y) =>
      let txt := (s.drop x).take (y - x)
      let r := if ic then matchFold rest rest.length (foldString txt txt.length [])
               else pfx txt rest
      match r with
      | some r' => some r'
      | none => bref s t ic cs rest

def clsiAlts (k : List Item) (ln : Nat) (cs : Caps) (rest : List Nat) :
    List (List Nat) → List Frame → List Frame
  | [], bt => bt
  | m :: t, bt =>
    match matchFold rest rest.length m with
    | some r => (k, ln - r.length, r, cs) :: clsiAlts k ln cs rest t bt
    | none => clsiAlts k ln cs rest t bt

def step (s : List Nat) (ln : Nat) (refs : List Nat) : State → State
  | .run its pos rest cs bt =>
    match its with
    | [] => .matched pos cs
    | .node .eps :: k => .run k pos rest cs bt
    | .node (.lit l) :: k =>
      match pfx l rest with
      | some r => .run k (pos + l.length) r cs bt
      | none => backtrack bt
    | .node (.litI f) :: k =>
      match matchFold rest rest.length f with
      | some r => .run k (ln - r.length) r cs bt
      | none => backtrack bt
    | .node (.cls cl) :: k =>
      match decode rest with
      | some (c, l, r) => if inCset c cl then .run k (pos + l) r cs bt else backtrack bt
      | none => backtrack bt
    | .node (.clsI cl ms) :: k =>
      let bt' := clsiAlts k ln cs rest ms bt
      match decode rest with
      | some (c, l, r) => if inCset c cl then .run k (pos + l) r cs bt' else backtrack bt'
      | none => backtrack bt'
    | .node (.cat a b) :: k => .run (.node a :: .node b :: k) pos rest cs bt
    | .node (.alt a b) :: k => .run (.node a :: k) pos rest cs ((.node b :: k, pos, rest, cs) :: bt)
    | .node (.rep mn mx g a) :: k => rep mn mx g a 0 k pos rest cs bt
    | .iter mn mx g a c p0 c0 :: k =>
      -- DEV-008: every loop, bounded or not, also below mn
      if pos == p0 && sameRefs refs cs c0 then .run k pos rest cs bt
      else rep mn mx g a c k pos rest cs bt
    | .node (.atomic a) :: k => .run (.node a :: .cut bt :: k) pos rest cs bt
    | .cut bt0 :: k => .run k pos rest cs bt0
    | .node (.ahead ng a) :: k =>
      if ng then .run (.node a :: .negFail bt :: k) pos rest cs ((k, pos, rest, cs) :: bt)
      else .run (.node a :: .lookOk bt pos rest :: k) pos rest cs bt
    | .lookOk bt0 p r :: k => .run k p r cs bt0
    | .negFail bt0 :: _ => backtrack bt0
    | .node (.behind ng alts) :: k =>
      if ng then .run (.bTry alts pos pos :: .negFail bt :: k) pos rest cs ((k, pos, rest, cs) :: bt)
      else .run (.bTry alts pos pos :: .lookOk bt pos rest :: k) pos rest cs bt
    | .bTry alts j i :: k =>
      match alts with
      | [] => backtrack bt
      | a :: t =>
        let next := match prevPos s j with
          | some p => Item.bTry alts p i :: k
          | none => Item.bTry t i i :: k
        .run (.node a :: .atEnd i :: k) j (s.drop j) cs ((next, pos, rest, cs) :: bt)
    | .atEnd i :: k => if pos == i then .run k pos rest cs bt else backtrack bt
    | .node (.group i a) :: k => .run (.node a :: .close i pos :: k) pos rest cs bt
    | .close i p0 :: k => .run k pos rest (setCap i (p0, pos) cs) bt
    | .node (.bref gs ic) :: k =>
      match bref s gs ic cs rest with
      | some r => .run k (ln - r.length) r cs bt
      | none => backtrack bt
    | .node (.anc a) :: k =>
      if anchorOk s ln a pos rest then .run k pos rest cs bt else backtrack bt
  | st => st

-- at most `fuel` steps
def run (s : List Nat) (ln : Nat) (refs : List Nat) : Nat → State → State
  | 0, st => st
  | f + 1, st@(.run ..) => run s ln refs f (step s ln refs st)
  | _ + 1, st => st

inductive Result where
  | rmatch (s e : Nat) (cs : Caps)
  | mismatch
  | limit

-- forward search: start positions 0..length, advanced by encLen
def searchFrom (s : List Nat) (ln : Nat) (refs : List Nat) :
    Nat → Nat → Node → Nat → List Nat → Result
  | 0, _, _, _, _ => .mismatch
  | n + 1, fuel, re, pos, rest =>
    match run s ln refs fuel (.run [.node re] pos rest [] []) with
    | .matched e cs => .rmatch pos e cs
    | .run .. => .limit
    | .failed =>
      match rest with
      | [] => .mismatch
      | b :: _ =>
        let l := encLen b
        match take l rest with
        | some (_, r) => searchFrom s ln refs n fuel re (pos + l) r
        | none => .mismatch

def search (fuel : Nat) (refs : List Nat) (re : Node) (s : List Nat) : Result :=
  let ln := s.length
  searchFrom s ln refs (ln + 1) fuel re 0 s

-- verdict as numbers: [0] no match, [2] limit, 1 :: s :: e :: groups,
-- each group [1, s, e] or [0] when unset
def encode (ncap : Nat) : Result → List Nat
  | .mismatch => [0]
  | .limit => [2]
  | .rmatch s e cs =>
    1 :: s :: e :: (List.range ncap).flatMap (fun i =>
      match lookup (i + 1) cs with
      | some (x, y) => [1, x, y]
      | none => [0])

def fuel0 : Nat := 10000000

def runCase (fuel ncap : Nat) (refs : List Nat) (re : Node) (s : List Nat) : List Nat :=
  encode ncap (search fuel refs re s)

-- a case: groups, backreferenced groups, pattern, subject, expected
abbrev Case := Nat × List Nat × Node × List Nat × List Nat

def agree (fuel : Nat) (c : Case) : Bool :=
  match c with
  | (ncap, refs, re, s, exp) => runCase fuel ncap refs re s == exp

def count (fuel : Nat) (cs : List Case) : Nat :=
  cs.foldl (fun acc c => if agree fuel c then acc + 1 else acc) 0

-- r passes; pass i uses fuel0 + i so that no pass can be shared
def passes : Nat → List Case → Nat → Nat
  | 0, _, acc => acc
  | r + 1, cs, acc => passes r cs (acc + count (fuel0 + r + 1) cs)

end Spec2
