module Spec2
(* Experiment #6, milestone 2, F*: executable semantics of experiment
   #1's first subset S2 of Oniguruma f95747b, transcribed from stack G
   (lab/06-spec-speed/g/g2.ml) into milestone 1's small-step machine
   (fstar/Spec.fst), as why3/spec2.mlw: pending items plus an explicit
   list of backtracking points, one machine step per call of [step],
   fuel a [nat] with a [decreases] clause.  Commit points (atomic groups,
   possessive quantifiers, lookaround bodies) are items that carry the
   backtracking list to restore.  The case-fold map and the property
   ranges come from the table module [Tables] (generated by
   cases/gen2.py), so that T_spec measures the semantics alone.  No
   refinements beyond [nat] in executable definitions. *)

open Tables

let rec len (l:list int) : nat = match l with [] -> 0 | _ :: t -> 1 + len t

let rec append (a b:list int) : list int = match a with [] -> b | x :: t -> x :: append t b

type cset =
  | CR : lo:int -> hi:int -> cset
  | CP : p:int -> cset
  | CNot : s:cset -> cset
  | COr : l:list cset -> cset
  | CAnd : a:cset -> b:cset -> cset

type anchor = | BolA | EolA | BufBeg | BufEnd | SemiEnd | SearchStart | WordB | NotWordB

type node =
  | Eps
  | Lit : bs:list int -> node
  | LitI : f:list int -> node                         (* folded pattern string *)
  | Cls : s:cset -> node
  | ClsI : s:cset -> ms:list (list int) -> node
  | Cat : a:node -> b:node -> node
  | Alt : a:node -> b:node -> node
  | Rep : mn:int -> mx:int -> g:bool -> a:node -> node   (* max -1: infinite *)
  | Atomic : a:node -> node
  | Ahead : neg:bool -> a:node -> node
  | Behind : neg:bool -> alts:list node -> node
  | Group : k:int -> a:node -> node
  | Bref : gs:list int -> ic:bool -> node
  | Anc : a:anchor -> node

type caps = list (int & (int & int))

type item =
  | INode : n:node -> item
  | IClose : k:int -> p:int -> item
  | IIter : mn:int -> mx:int -> g:bool -> a:node -> c:int -> p0:int -> c0:caps -> item
  | ICut : bt:list frame -> item
  | ILookOk : bt:list frame -> p:int -> r:list int -> item
  | INegFail : bt:list frame -> item
  | IAtEnd : i:int -> item
  | IBTry : alts:list node -> j:int -> i:int -> item
(* backtracking point: items, position, rest of the subject, captures *)
and frame =
  | Frame : its:list item -> pos:int -> rest:list int -> cs:caps -> frame

type state =
  | Run : its:list item -> pos:int -> rest:list int -> cs:caps -> bt:list frame -> state
  | Matched : pos:int -> cs:caps -> state
  | Failed

let enc_len (b:int) : nat =
  if b < 194 then 1 else if b < 224 then 2 else if b < 240 then 3
  else if b < 245 then 4 else 1

let rec take_opt (n:nat) (l:list int) : Tot (option (list int & list int)) (decreases n) =
  if n = 0 then Some ([], l)
  else match l with
    | [] -> None
    | x :: t ->
      (match take_opt (n - 1) t with
       | Some (a, r) -> Some (x :: a, r)
       | None -> None)

let rec drop0 (n:int) (l:list int) : Tot (list int) (decreases l) =
  if n <= 0 then l else match l with [] -> [] | _ :: t -> drop0 (n - 1) t

let rec take (n:int) (l:list int) : Tot (list int) (decreases l) =
  if n <= 0 then [] else match l with [] -> [] | x :: t -> x :: take (n - 1) t

let lead_mod (l:nat) : int = if l = 2 then 32 else if l = 3 then 16 else 8

let rec fold_code (v:int) (l:list int) : Tot int (decreases l) =
  match l with
  | [] -> v
  | d :: t -> fold_code (v * 64 + d % 64) t

let decode (rest:list int) : option (int & nat & list int) =
  match rest with
  | [] -> None
  | b :: t ->
    let l = enc_len b in
    if l = 1 then Some (b, 1, t)
    else match take_opt (l - 1) t with
      | Some (tl, r) -> Some (fold_code (b % lead_mod l) tl, l, r)
      | None -> None

let rec prefix (l rest:list int) : option (list int) =
  match l, rest with
  | [], _ -> Some rest
  | x :: l', y :: r -> if x = y then prefix l' r else None
  | _, [] -> None

let rec in_cset (c:int) (s:cset) : Tot bool (decreases s) =
  match s with
  | CR lo hi -> lo <= c && c <= hi
  | CP p -> in_prop p c
  | CNot s' -> not (in_cset c s')
  | COr l -> in_csets c l
  | CAnd a b -> in_cset c a && in_cset c b
and in_csets (c:int) (l:list cset) : Tot bool (decreases l) =
  match l with
  | [] -> false
  | s :: t -> in_cset c s || in_csets c t

(* the remainder of [f] once [p] is stripped from its front *)
let rec strip (p f:list int) : option (list int) =
  match p, f with
  | [], _ -> Some f
  | x :: p', y :: f' -> if x = y then strip p' f' else None
  | _, [] -> None

(* a subject segment whose full case fold is exactly [f]: rest after it *)
let rec match_fold (rest:list int) (n:nat) (f:list int) : Tot (option (list int)) (decreases n) =
  match f with
  | [] -> Some rest
  | _ ->
    if n = 0 then None
    else match decode rest with
      | None -> None
      | Some (c, _, r) ->
        (match strip (fold_of c) f with
         | Some f' -> match_fold r (n - 1) f'
         | None -> None)

let rec fold_string (l:list int) (n:nat) (acc:list int) : Tot (list int) (decreases n) =
  if n = 0 then acc
  else match decode l with
    | None -> acc
    | Some (c, _, r) -> fold_string r (n - 1) (append acc (fold_of c))

let rec set_cap (k:int) (v:int & int) (cs:caps) : caps =
  match cs with
  | [] -> [(k, v)]
  | (k', w) :: t -> if k' = k then (k, v) :: t else (k', w) :: set_cap k v t

let rec lookup (k:int) (cs:caps) : option (int & int) =
  match cs with
  | [] -> None
  | (k', v) :: t -> if k = k' then Some v else lookup k t

let rec same_refs (refs:list int) (a b:caps) : bool =
  match refs with
  | [] -> true
  | g :: t -> lookup g a = lookup g b && same_refs t a b

(* start of the character before [pos], or -1 *)
let rec prev_from (l:list int) (i pos last:int) : Tot int (decreases l) =
  if i >= pos then last
  else match l with
    | [] -> last
    | b :: t -> prev_from t (i + 1) pos (if 128 <= b && b < 192 then last else i)

let prev_pos (s:list int) (pos:int) : int = prev_from s 0 pos (-1)

let word_at (rest:list int) : bool =
  match decode rest with Some (c, _, _) -> in_prop 12 c | None -> false

let word_before (s:list int) (pos:int) : bool =
  let p = prev_pos s pos in p >= 0 && word_at (drop0 p s)

let is_nl (l:list int) : bool = match l with b :: _ -> b = 10 | [] -> false

let anchor_ok (s:list int) (ln:int) (a:anchor) (pos:int) (rest:list int) : bool =
  match a with
  | BolA -> pos = 0 || is_nl (drop0 (pos - 1) s)
  | EolA -> pos = ln || is_nl rest
  | BufBeg | SearchStart -> pos = 0
  | BufEnd -> pos = ln
  | SemiEnd -> pos = ln || (pos = ln - 1 && is_nl rest)
  | WordB -> word_before s pos <> word_at rest
  | NotWordB -> word_before s pos = word_at rest

let backtrack (bt:list frame) : state =
  match bt with
  | [] -> Failed
  | Frame its pos rest cs :: bt' -> Run its pos rest cs bt'

(* the next iteration of a loop, or leaving it *)
let rep (mn mx:int) (g:bool) (a:node) (c:int) (k:list item) (pos:int) (rest:list int)
        (cs:caps) (bt:list frame) : state =
  let again = INode a :: IIter mn mx g a (c + 1) pos cs :: k in
  if c < mn then Run again pos rest cs bt
  else if mx >= 0 && c >= mx then Run k pos rest cs bt
  else if g then Run again pos rest cs (Frame k pos rest cs :: bt)
  else Run k pos rest cs (Frame again pos rest cs :: bt)

(* backreference: the groups in order, the first one set and matching *)
let rec bref (s:list int) (gs:list int) (ic:bool) (cs:caps) (rest:list int)
  : Tot (option (list int)) (decreases gs) =
  match gs with
  | [] -> None
  | g :: t ->
    match lookup g cs with
    | None -> bref s t ic cs rest
    | Some (x, y) ->
      let txt = take (y - x) (drop0 x s) in
      let r = if ic then match_fold rest (len rest) (fold_string txt (len txt) [])
              else prefix txt rest in
      match r with
      | Some r' -> Some r'
      | None -> bref s t ic cs rest

let rec clsi_alts (k:list item) (ln:int) (cs:caps) (rest:list int) (ms:list (list int))
                  (bt:list frame) : Tot (list frame) (decreases ms) =
  match ms with
  | [] -> bt
  | m :: t ->
    match match_fold rest (len rest) m with
    | Some r -> Frame k (ln - len r) r cs :: clsi_alts k ln cs rest t bt
    | None -> clsi_alts k ln cs rest t bt

let step (s:list int) (ln:int) (refs:list int) (st:state) : state =
  match st with
  | Run its pos rest cs bt ->
    (match its with
     | [] -> Matched pos cs
     | INode Eps :: k -> Run k pos rest cs bt
     | INode (Lit l) :: k ->
       (match prefix l rest with
        | Some r -> Run k (pos + len l) r cs bt
        | None -> backtrack bt)
     | INode (LitI f) :: k ->
       (match match_fold rest (len rest) f with
        | Some r -> Run k (ln - len r) r cs bt
        | None -> backtrack bt)
     | INode (Cls cl) :: k ->
       (match decode rest with
        | Some (c, l, r) -> if in_cset c cl then Run k (pos + l) r cs bt else backtrack bt
        | None -> backtrack bt)
     | INode (ClsI cl ms) :: k ->
       let bt' = clsi_alts k ln cs rest ms bt in
       (match decode rest with
        | Some (c, l, r) -> if in_cset c cl then Run k (pos + l) r cs bt' else backtrack bt'
        | None -> backtrack bt')
     | INode (Cat a b) :: k -> Run (INode a :: INode b :: k) pos rest cs bt
     | INode (Alt a b) :: k -> Run (INode a :: k) pos rest cs (Frame (INode b :: k) pos rest cs :: bt)
     | INode (Rep mn mx g a) :: k -> rep mn mx g a 0 k pos rest cs bt
     | IIter mn mx g a c p0 c0 :: k ->
       if c > mn && mx < 0 && pos = p0 && same_refs refs cs c0 then Run k pos rest cs bt
       else rep mn mx g a c k pos rest cs bt
     | INode (Atomic a) :: k -> Run (INode a :: ICut bt :: k) pos rest cs bt
     | ICut bt0 :: k -> Run k pos rest cs bt0
     | INode (Ahead ng a) :: k ->
       if ng then Run (INode a :: INegFail bt :: k) pos rest cs (Frame k pos rest cs :: bt)
       else Run (INode a :: ILookOk bt pos rest :: k) pos rest cs bt
     | ILookOk bt0 p r :: k -> Run k p r cs bt0
     | INegFail bt0 :: _ -> backtrack bt0
     | INode (Behind ng alts) :: k ->
       if ng then Run (IBTry alts pos pos :: INegFail bt :: k) pos rest cs (Frame k pos rest cs :: bt)
       else Run (IBTry alts pos pos :: ILookOk bt pos rest :: k) pos rest cs bt
     | IBTry alts j i :: k ->
       (match alts with
        | [] -> backtrack bt
        | a :: t ->
          let p = prev_pos s j in
          let next = if p >= 0 then IBTry alts p i :: k else IBTry t i i :: k in
          Run (INode a :: IAtEnd i :: k) j (drop0 j s) cs (Frame next pos rest cs :: bt))
     | IAtEnd i :: k -> if pos = i then Run k pos rest cs bt else backtrack bt
     | INode (Group i a) :: k -> Run (INode a :: IClose i pos :: k) pos rest cs bt
     | IClose i p0 :: k -> Run k pos rest (set_cap i (p0, pos) cs) bt
     | INode (Bref gs ic) :: k ->
       (match bref s gs ic cs rest with
        | Some r -> Run k (ln - len r) r cs bt
        | None -> backtrack bt)
     | INode (Anc a) :: k ->
       if anchor_ok s ln a pos rest then Run k pos rest cs bt else backtrack bt)
  | _ -> st

let rec run (s:list int) (ln:int) (refs:list int) (fuel:nat) (st:state) : Tot state (decreases fuel) =
  if fuel = 0 then st
  else match st with
    | Run _ _ _ _ _ -> run s ln refs (fuel - 1) (step s ln refs st)
    | _ -> st

type result =
  | RMatch : s:int -> e:int -> cs:caps -> result
  | RMismatch
  | RLimit

let rec search_from (s:list int) (ln:int) (refs:list int) (n fuel:nat) (re:node) (pos:int)
                    (rest:list int) : Tot result (decreases n) =
  if n = 0 then RMismatch
  else match run s ln refs fuel (Run [INode re] pos rest [] []) with
    | Matched e cs -> RMatch pos e cs
    | Run _ _ _ _ _ -> RLimit
    | Failed ->
      (match rest with
       | [] -> RMismatch
       | b :: _ ->
         let l = enc_len b in
         (match take_opt l rest with
          | Some (_, r) -> search_from s ln refs (n - 1) fuel re (pos + l) r
          | None -> RMismatch))

let search (fuel:nat) (refs:list int) (re:node) (s:list int) : result =
  let ln = len s in search_from s ln refs (ln + 1) fuel re 0 s

let rec groups (k:nat) (cs:caps) (acc:list int) : Tot (list int) (decreases k) =
  if k = 0 then acc
  else groups (k - 1) cs (match lookup k cs with
                          | Some (x, y) -> 1 :: x :: y :: acc
                          | None -> 0 :: acc)

let encode (ncap:nat) (r:result) : list int =
  match r with
  | RMismatch -> [0]
  | RLimit -> [2]
  | RMatch s e cs -> 1 :: s :: e :: groups ncap cs []

let fuel0 : nat = 10000000

let run_case (fuel ncap:nat) (refs:list int) (re:node) (s:list int) : list int =
  encode ncap (search fuel refs re s)

(* a case: groups, backreferenced groups, pattern, subject, expected *)
type case = nat & list int & node & list int & list int

let agree (fuel:nat) (c:case) : bool =
  let (ncap, refs, re, s, exp) = c in run_case fuel ncap refs re s = exp

let rec count_acc (fuel:nat) (cs:list case) (acc:nat) : Tot nat (decreases cs) =
  match cs with
  | [] -> acc
  | c :: t -> count_acc fuel t (if agree fuel c then acc + 1 else acc)

let count (fuel:nat) (cs:list case) : nat = count_acc fuel cs 0

(* r passes; pass i uses fuel0 + i so that no pass can be shared *)
let rec passes (r:nat) (cs:list case) (acc:nat) : Tot nat (decreases r) =
  if r = 0 then acc else passes (r - 1) cs (acc + count (fuel0 + r) cs)

(* the first [m] cases only (calibration on a prefix) *)
let rec take_cases (m:nat) (cs:list case) : Tot (list case) (decreases m) =
  if m = 0 then [] else match cs with [] -> [] | c :: t -> c :: take_cases (m - 1) t
