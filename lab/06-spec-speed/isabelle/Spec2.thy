(* Experiment #6, milestone 2, Isabelle/HOL: executable semantics of
   experiment #1's first subset S2 of Oniguruma f95747b, transcribed from
   stack G (lab/06-spec-speed/g/g2.ml) into milestone 1's small-step
   machine (isabelle/Spec.thy), item for item as lean/Spec2.lean,
   rocq/Spec2.v and fstar/Spec2.fst: pending items plus an explicit list
   of backtracking points, one machine step per call of step, fuel on
   nat.  Commit points (atomic groups, possessive quantifiers, lookaround
   bodies) are items that carry the backtracking list to restore.  The
   case-fold map and the property ranges come from the theory Tables
   (generated by cases/gen2.py, in a parent session), so that T_spec
   measures the semantics alone.  Recursion on nat is written with
   "if n = 0" rather than 0/Suc patterns (Code_Target_Nat), as in
   milestone 1. *)

theory Spec2
  imports Tables
begin

datatype cset =
    CR nat nat
  | CP nat
  | CNot cset
  | COr "cset list"
  | CAnd cset cset

datatype anchor = BolA | EolA | BufBeg | BufEnd | SemiEnd | SearchStart | WordB | NotWordB

datatype node =
    Eps
  | Lit "nat list"
  | LitI "nat list"                         (* folded pattern string *)
  | Cls cset
  | ClsI cset "nat list list"
  | Cat node node
  | Alt node node
  | Rep nat "nat option" bool node          (* None: infinite *)
  | Atomic node
  | Ahead bool node
  | Behind bool "node list"
  | Group nat node
  | Bref "nat list" bool
  | Anc anchor

type_synonym caps = "(nat \<times> (nat \<times> nat)) list"

(* backtracking point: items, position, rest of the subject, captures *)
datatype item =
    INode node
  | IClose nat nat
  | IIter nat "nat option" bool node nat nat caps
  | ICut "(item list \<times> nat \<times> nat list \<times> caps) list"
  | ILookOk "(item list \<times> nat \<times> nat list \<times> caps) list" nat "nat list"
  | INegFail "(item list \<times> nat \<times> nat list \<times> caps) list"
  | IAtEnd nat
  | IBTry "node list" nat nat

type_synonym frame = "item list \<times> nat \<times> nat list \<times> caps"

datatype state =
    Run "item list" nat "nat list" caps "frame list"
  | Matched nat caps
  | Failed

(* UTF-8, as upstream/src/utf8.c (EncLen_UTF8, USE_RFC3629_RANGE) *)
definition enc_len :: "nat \<Rightarrow> nat" where
  "enc_len b = (if b < 194 then 1 else if b < 224 then 2 else if b < 240 then 3
               else if b < 245 then 4 else 1)"

fun take_n :: "nat \<Rightarrow> nat list \<Rightarrow> (nat list \<times> nat list) option" where
  "take_n n l = (if n = 0 then Some ([], l)
                 else (case l of [] \<Rightarrow> None
                       | x # t \<Rightarrow> (case take_n (n - 1) t of
                                    Some (a, r) \<Rightarrow> Some (x # a, r) | None \<Rightarrow> None)))"

definition lead_mod :: "nat \<Rightarrow> nat" where
  "lead_mod l = (if l = 2 then 32 else if l = 3 then 16 else 8)"

(* code point, encoded length, rest; None past the end (DATA_ENSURE) *)
definition decode :: "nat list \<Rightarrow> (nat \<times> nat \<times> nat list) option" where
  "decode rest = (case rest of
     [] \<Rightarrow> None
   | b # t \<Rightarrow> (let l = enc_len b in
       if l = 1 then Some (b, 1, t)
       else (case take_n (l - 1) t of
               Some (tb, r) \<Rightarrow> Some (foldl (\<lambda>v d. v * 64 + d mod 64) (b mod lead_mod l) tb, l, r)
             | None \<Rightarrow> None)))"

fun pfx :: "nat list \<Rightarrow> nat list \<Rightarrow> nat list option" where
  "pfx [] rest = Some rest"
| "pfx (x # l) (y # r) = (if x = y then pfx l r else None)"
| "pfx (x # l) [] = None"

fun in_cset :: "nat \<Rightarrow> cset \<Rightarrow> bool"
and in_csets :: "nat \<Rightarrow> cset list \<Rightarrow> bool" where
  "in_cset c (CR lo hi) = (lo \<le> c \<and> c \<le> hi)"
| "in_cset c (CP p) = in_prop p c"
| "in_cset c (CNot s) = (\<not> in_cset c s)"
| "in_cset c (COr l) = in_csets c l"
| "in_cset c (CAnd a b) = (in_cset c a \<and> in_cset c b)"
| "in_csets c [] = False"
| "in_csets c (s # t) = (in_cset c s \<or> in_csets c t)"

(* the remainder of f once p is stripped from its front *)
fun strip :: "nat list \<Rightarrow> nat list \<Rightarrow> nat list option" where
  "strip [] f = Some f"
| "strip (x # p) (y # f) = (if x = y then strip p f else None)"
| "strip (x # p) [] = None"

(* a subject segment whose full case fold is exactly f: rest after it *)
fun match_fold :: "nat list \<Rightarrow> nat \<Rightarrow> nat list \<Rightarrow> nat list option" where
  "match_fold rest n f =
     (if f = [] then Some rest
      else if n = 0 then None
      else (case decode rest of
              None \<Rightarrow> None
            | Some (c, _, r) \<Rightarrow> (case strip (fold_of c) f of
                                   Some f' \<Rightarrow> match_fold r (n - 1) f'
                                 | None \<Rightarrow> None)))"

fun fold_string :: "nat list \<Rightarrow> nat \<Rightarrow> nat list \<Rightarrow> nat list" where
  "fold_string l n acc =
     (if n = 0 then acc
      else (case decode l of
              None \<Rightarrow> acc
            | Some (c, _, r) \<Rightarrow> fold_string r (n - 1) (acc @ fold_of c)))"

fun set_cap :: "nat \<Rightarrow> nat \<times> nat \<Rightarrow> caps \<Rightarrow> caps" where
  "set_cap k v [] = [(k, v)]"
| "set_cap k v ((k', w) # t) = (if k' = k then (k, v) # t else (k', w) # set_cap k v t)"

fun lookup :: "nat \<Rightarrow> caps \<Rightarrow> (nat \<times> nat) option" where
  "lookup k [] = None"
| "lookup k ((k', v) # t) = (if k = k' then Some v else lookup k t)"

fun same_refs :: "nat list \<Rightarrow> caps \<Rightarrow> caps \<Rightarrow> bool" where
  "same_refs [] a b = True"
| "same_refs (g # t) a b = (lookup g a = lookup g b \<and> same_refs t a b)"

(* start of the character before pos, or None *)
fun prev_from :: "nat list \<Rightarrow> nat \<Rightarrow> nat \<Rightarrow> nat option \<Rightarrow> nat option" where
  "prev_from [] i pos lst = lst"
| "prev_from (b # t) i pos lst =
     (if pos \<le> i then lst
      else prev_from t (i + 1) pos (if 128 \<le> b \<and> b < 192 then lst else Some i))"

definition prev_pos :: "nat list \<Rightarrow> nat \<Rightarrow> nat option" where
  "prev_pos s pos = prev_from s 0 pos None"

definition word_at :: "nat list \<Rightarrow> bool" where
  "word_at rest = (case decode rest of Some (c, _, _) \<Rightarrow> in_prop 12 c | None \<Rightarrow> False)"

definition word_before :: "nat list \<Rightarrow> nat \<Rightarrow> bool" where
  "word_before s pos = (case prev_pos s pos of Some p \<Rightarrow> word_at (drop p s) | None \<Rightarrow> False)"

definition is_nl :: "nat list \<Rightarrow> bool" where
  "is_nl l = (case l of b # _ \<Rightarrow> b = 10 | [] \<Rightarrow> False)"

definition anchor_ok :: "nat list \<Rightarrow> nat \<Rightarrow> anchor \<Rightarrow> nat \<Rightarrow> nat list \<Rightarrow> bool" where
  "anchor_ok s sl a pos rest = (case a of
     BolA \<Rightarrow> pos = 0 \<or> is_nl (drop (pos - 1) s)
   | EolA \<Rightarrow> pos = sl \<or> is_nl rest
   | BufBeg \<Rightarrow> pos = 0
   | SearchStart \<Rightarrow> pos = 0
   | BufEnd \<Rightarrow> pos = sl
   | SemiEnd \<Rightarrow> pos = sl \<or> (pos + 1 = sl \<and> is_nl rest)
   | WordB \<Rightarrow> word_before s pos \<noteq> word_at rest
   | NotWordB \<Rightarrow> word_before s pos = word_at rest)"

definition backtrack :: "frame list \<Rightarrow> state" where
  "backtrack bt = (case bt of [] \<Rightarrow> Failed | (its, pos, rest, cs) # t \<Rightarrow> Run its pos rest cs t)"

(* the next iteration of a loop, or leaving it *)
definition rep :: "nat \<Rightarrow> nat option \<Rightarrow> bool \<Rightarrow> node \<Rightarrow> nat \<Rightarrow> item list \<Rightarrow> nat \<Rightarrow> nat list
                   \<Rightarrow> caps \<Rightarrow> frame list \<Rightarrow> state" where
  "rep mn mx g a c k pos rest cs bt =
     (let again = INode a # IIter mn mx g a (c + 1) pos cs # k;
          at_max = (case mx of Some m \<Rightarrow> m \<le> c | None \<Rightarrow> False) in
      if c < mn then Run again pos rest cs bt
      else if at_max then Run k pos rest cs bt
      else if g then Run again pos rest cs ((k, pos, rest, cs) # bt)
      else Run k pos rest cs ((again, pos, rest, cs) # bt))"

(* backreference: the groups in order, the first one set and matching *)
fun bref :: "nat list \<Rightarrow> nat list \<Rightarrow> bool \<Rightarrow> caps \<Rightarrow> nat list \<Rightarrow> nat list option" where
  "bref s [] ic cs rest = None"
| "bref s (g # t) ic cs rest =
     (case lookup g cs of
        None \<Rightarrow> bref s t ic cs rest
      | Some (x, y) \<Rightarrow>
          (let txt = take (y - x) (drop x s);
               r = (if ic then match_fold rest (length rest) (fold_string txt (length txt) [])
                    else pfx txt rest) in
           (case r of Some r' \<Rightarrow> Some r' | None \<Rightarrow> bref s t ic cs rest)))"

fun clsi_alts :: "item list \<Rightarrow> nat \<Rightarrow> caps \<Rightarrow> nat list \<Rightarrow> nat list list \<Rightarrow> frame list \<Rightarrow> frame list" where
  "clsi_alts k sl cs rest [] bt = bt"
| "clsi_alts k sl cs rest (m # t) bt =
     (case match_fold rest (length rest) m of
        Some r \<Rightarrow> (k, sl - length r, r, cs) # clsi_alts k sl cs rest t bt
      | None \<Rightarrow> clsi_alts k sl cs rest t bt)"

definition step_node :: "nat list \<Rightarrow> nat \<Rightarrow> node \<Rightarrow> item list \<Rightarrow> nat \<Rightarrow> nat list \<Rightarrow> caps
                         \<Rightarrow> frame list \<Rightarrow> state" where
  "step_node s sl n k pos rest cs bt = (case n of
     Eps \<Rightarrow> Run k pos rest cs bt
   | Lit l \<Rightarrow> (case pfx l rest of Some r \<Rightarrow> Run k (pos + length l) r cs bt | None \<Rightarrow> backtrack bt)
   | LitI f \<Rightarrow> (case match_fold rest (length rest) f of
                 Some r \<Rightarrow> Run k (sl - length r) r cs bt | None \<Rightarrow> backtrack bt)
   | Cls cl \<Rightarrow> (case decode rest of
                 Some (c, l, r) \<Rightarrow> (if in_cset c cl then Run k (pos + l) r cs bt else backtrack bt)
               | None \<Rightarrow> backtrack bt)
   | ClsI cl ms \<Rightarrow> (let bt' = clsi_alts k sl cs rest ms bt in
                    (case decode rest of
                       Some (c, l, r) \<Rightarrow> (if in_cset c cl then Run k (pos + l) r cs bt' else backtrack bt')
                     | None \<Rightarrow> backtrack bt'))
   | Cat a b \<Rightarrow> Run (INode a # INode b # k) pos rest cs bt
   | Alt a b \<Rightarrow> Run (INode a # k) pos rest cs ((INode b # k, pos, rest, cs) # bt)
   | Rep mn mx g a \<Rightarrow> rep mn mx g a 0 k pos rest cs bt
   | Atomic a \<Rightarrow> Run (INode a # ICut bt # k) pos rest cs bt
   | Ahead ng a \<Rightarrow>
       (if ng then Run (INode a # INegFail bt # k) pos rest cs ((k, pos, rest, cs) # bt)
        else Run (INode a # ILookOk bt pos rest # k) pos rest cs bt)
   | Behind ng alts \<Rightarrow>
       (if ng then Run (IBTry alts pos pos # INegFail bt # k) pos rest cs ((k, pos, rest, cs) # bt)
        else Run (IBTry alts pos pos # ILookOk bt pos rest # k) pos rest cs bt)
   | Group i a \<Rightarrow> Run (INode a # IClose i pos # k) pos rest cs bt
   | Bref gs ic \<Rightarrow> (case bref s gs ic cs rest of
                     Some r \<Rightarrow> Run k (sl - length r) r cs bt | None \<Rightarrow> backtrack bt)
   | Anc a \<Rightarrow> (if anchor_ok s sl a pos rest then Run k pos rest cs bt else backtrack bt))"

(* IIter: DEV-008, the empty check applies to every loop, bounded or not,
   also below mn *)
definition step :: "nat list \<Rightarrow> nat \<Rightarrow> nat list \<Rightarrow> state \<Rightarrow> state" where
  "step s sl refs st = (case st of
     Run its pos rest cs bt \<Rightarrow> (case its of
       [] \<Rightarrow> Matched pos cs
     | it # k \<Rightarrow> (case it of
         INode n \<Rightarrow> step_node s sl n k pos rest cs bt
       | IIter mn mx g a c p0 c0 \<Rightarrow>
           (if pos = p0 \<and> same_refs refs cs c0 then Run k pos rest cs bt
            else rep mn mx g a c k pos rest cs bt)
       | ICut bt0 \<Rightarrow> Run k pos rest cs bt0
       | ILookOk bt0 p r \<Rightarrow> Run k p r cs bt0
       | INegFail bt0 \<Rightarrow> backtrack bt0
       | IBTry alts j i \<Rightarrow> (case alts of
           [] \<Rightarrow> backtrack bt
         | a # t \<Rightarrow>
             (let nxt = (case prev_pos s j of
                            Some p \<Rightarrow> IBTry alts p i # k
                          | None \<Rightarrow> IBTry t i i # k) in
              Run (INode a # IAtEnd i # k) j (drop j s) cs ((nxt, pos, rest, cs) # bt)))
       | IAtEnd i \<Rightarrow> (if pos = i then Run k pos rest cs bt else backtrack bt)
       | IClose i p0 \<Rightarrow> Run k pos rest (set_cap i (p0, pos) cs) bt))
   | _ \<Rightarrow> st)"

(* at most f steps *)
fun run :: "nat list \<Rightarrow> nat \<Rightarrow> nat list \<Rightarrow> nat \<Rightarrow> state \<Rightarrow> state" where
  "run s sl refs f st = (if f = 0 then st
     else (case st of Run _ _ _ _ _ \<Rightarrow> run s sl refs (f - 1) (step s sl refs st) | _ \<Rightarrow> st))"

datatype result = RMatch nat nat caps | RMismatch | RLimit

(* forward search: start positions 0..length, advanced by enc_len *)
fun search_from :: "nat list \<Rightarrow> nat \<Rightarrow> nat list \<Rightarrow> nat \<Rightarrow> nat \<Rightarrow> node \<Rightarrow> nat \<Rightarrow> nat list \<Rightarrow> result" where
  "search_from s sl refs n fuel re pos rest = (if n = 0 then RMismatch else
     (case run s sl refs fuel (Run [INode re] pos rest [] []) of
        Matched e cs \<Rightarrow> RMatch pos e cs
      | Run _ _ _ _ _ \<Rightarrow> RLimit
      | Failed \<Rightarrow> (case rest of
          [] \<Rightarrow> RMismatch
        | b # _ \<Rightarrow> (case take_n (enc_len b) rest of
                     Some (_, r) \<Rightarrow> search_from s sl refs (n - 1) fuel re (pos + enc_len b) r
                   | None \<Rightarrow> RMismatch))))"

definition search :: "nat \<Rightarrow> nat list \<Rightarrow> node \<Rightarrow> nat list \<Rightarrow> result" where
  "search fuel refs re s = (let sl = length s in search_from s sl refs (sl + 1) fuel re 0 s)"

(* verdict as numbers: [0] no match, [2] limit, 1 # s # e # groups,
   each group [1, s, e] or [0] when unset *)
fun encode :: "nat \<Rightarrow> result \<Rightarrow> nat list" where
  "encode ncap RMismatch = [0]"
| "encode ncap RLimit = [2]"
| "encode ncap (RMatch s e cs) =
     1 # s # e # concat (map (\<lambda>k. case lookup k cs of Some (x, y) \<Rightarrow> [1, x, y] | None \<Rightarrow> [0])
                             [1..<ncap + 1])"

definition fuel0 :: nat where "fuel0 = 10000000"

definition run_case :: "nat \<Rightarrow> nat \<Rightarrow> nat list \<Rightarrow> node \<Rightarrow> nat list \<Rightarrow> nat list" where
  "run_case fuel ncap refs re s = encode ncap (search fuel refs re s)"

(* a case: groups, backreferenced groups, pattern, subject, expected *)
type_synonym tcase = "nat \<times> nat list \<times> node \<times> nat list \<times> nat list"

definition agree :: "nat \<Rightarrow> tcase \<Rightarrow> bool" where
  "agree fuel c = (case c of (ncap, refs, re, s, exp) \<Rightarrow> run_case fuel ncap refs re s = exp)"

definition count :: "nat \<Rightarrow> tcase list \<Rightarrow> nat" where
  "count fuel cs = foldl (\<lambda>acc c. if agree fuel c then acc + 1 else acc) 0 cs"

(* r passes; pass i uses fuel0 + i so that no pass can be shared *)
fun passes :: "nat \<Rightarrow> tcase list \<Rightarrow> nat \<Rightarrow> nat" where
  "passes r cs acc = (if r = 0 then acc else passes (r - 1) cs (acc + count (fuel0 + r) cs))"

end
