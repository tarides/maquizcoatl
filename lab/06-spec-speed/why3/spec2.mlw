(* Experiment #6, milestone 2, Why3: executable semantics of experiment
   #1's first subset S2 of Oniguruma f95747b, transcribed from stack G
   (lab/06-spec-speed/g/g2.ml) into milestone 1's small-step machine
   (why3/spec.mlw): pending items plus an explicit list of backtracking
   points, one machine step per call of [step], fuel as an int variant.
   Commit points (atomic groups, possessive quantifiers, lookaround
   bodies) are items that carry the backtracking list to restore.

   As in milestone 1, every sequence type is monomorphic and no option
   or tuple carries a list (Why3 1.9.0's [why3 execute] bug with
   polymorphic constructors holding a list).  The case-fold map and the
   property ranges come from the table module [tables.Tables]
   (generated by cases/gen2.py), so that the semantics, measured by
   T_spec, excludes the tables. *)

module Spec2

  use int.Int
  use int.EuclideanDivision
  use bool.Bool
  use tables.Tables

  (* bytes / code-point lists; [bytes] is declared in tables.Tables *)

  type cset =
    | CR int int
    | CP int
    | CNot cset
    | COr csets
    | CAnd cset cset
  with csets = SNil | SCons cset csets

  type folds = FsNil | FsCons bytes folds

  type anchor = BolA | EolA | BufBeg | BufEnd | SemiEnd | SearchStart | WordB | NotWordB

  type node =
    | Eps
    | Lit bytes
    | LitI bytes                       (* folded pattern string *)
    | Cls cset
    | ClsI cset folds
    | Cat node node
    | Alt node node
    | Rep int int bool node            (* min, max (-1: infinite), greedy *)
    | Atomic node
    | Ahead bool node                  (* negative?, body *)
    | Behind bool nodes                (* negative?, top-level alternatives *)
    | Group int node
    | Bref bytes bool                  (* groups (highest first), ignore case *)
    | Anc anchor
  with nodes = NNil | NCons node nodes

  type caps = CNil | CCons int int int caps         (* group, start, end *)

  type item =
    | INode node
    | IClose int int                   (* group, start position *)
    | IIter int int bool node int int caps
      (* loop min, max, greedy, body, iterations done, position and
         captures at the start of the last iteration *)
    | ICut frames                      (* atomic: commit *)
    | ILookOk frames int bytes         (* positive lookaround: commit, back to pos *)
    | INegFail frames                  (* negative lookaround body matched: fail *)
    | IAtEnd int                       (* lookbehind: must end here *)
    | IBTry nodes int int              (* lookbehind: alternatives, start, end *)
  with items = INil | ICons item items
  (* backtracking points: items, position, rest of the subject, captures *)
  with frames = FNil | FCons items int bytes caps frames

  type state =
    | Run items int bytes caps frames
    | Matched int caps
    | Failed

  let enc_len (b : int) : int =
    if b < 194 then 1 else if b < 224 then 2 else if b < 240 then 3
    else if b < 245 then 4 else 1

  type dropped = Short | Rest bytes

  let rec drop (n : int) (l : bytes) : dropped
    requires { n >= 0 } variant { n }
  = if n = 0 then Rest l
    else match l with
      | BNil -> Short
      | BCons _ t -> drop (n - 1) t
      end

  let rec drop0 (n : int) (l : bytes) : bytes
    requires { n >= 0 } variant { n }
  = if n = 0 then l
    else match l with
      | BNil -> BNil
      | BCons _ t -> drop0 (n - 1) t
      end

  let rec take (n : int) (l : bytes) : bytes
    requires { n >= 0 } variant { n }
  = if n = 0 then BNil
    else match l with
      | BNil -> BNil
      | BCons x t -> BCons x (take (n - 1) t)
      end

  let lead_mod (l : int) : int =
    if l = 2 then 32 else if l = 3 then 16 else 8

  let rec fold_code (v : int) (n : int) (l : bytes) : int
    requires { n >= 0 } variant { n }
  = if n = 0 then v
    else match l with
      | BNil -> v
      | BCons d t -> fold_code (v * 64 + mod d 64) (n - 1) t
      end

  type decoded = NoChar | Char int int bytes

  let decode (rest : bytes) : decoded =
    match rest with
    | BNil -> NoChar
    | BCons b t ->
      let l = enc_len b in
      if l = 1 then Char b 1 t
      else match drop (l - 1) t with
        | Rest r -> Char (fold_code (mod b (lead_mod l)) (l - 1) t) l r
        | Short -> NoChar
        end
    end

  let rec prefix (l rest : bytes) : dropped variant { l } =
    match l, rest with
    | BNil, _ -> Rest rest
    | BCons x l', BCons y r -> if x = y then prefix l' r else Short
    | _, BNil -> Short
    end

  let rec length (l : bytes) : int variant { l } =
    match l with BNil -> 0 | BCons _ t -> 1 + length t end

  let rec append (a b : bytes) : bytes variant { a } =
    match a with BNil -> b | BCons x t -> BCons x (append t b) end

  let rec in_cset (c : int) (s : cset) : bool variant { s } =
    match s with
    | CR lo hi -> lo <= c && c <= hi
    | CP p -> in_prop p c
    | CNot s' -> not (in_cset c s')
    | COr l -> in_csets c l
    | CAnd a b -> in_cset c a && in_cset c b
    end
  with in_csets (c : int) (l : csets) : bool variant { l } =
    match l with
    | SNil -> false
    | SCons s t -> in_cset c s || in_csets c t
    end

  (* the remainder of [f] once [p] is stripped from its front *)
  let rec strip (p f : bytes) : dropped variant { p } =
    match p, f with
    | BNil, _ -> Rest f
    | BCons x p', BCons y f' -> if x = y then strip p' f' else Short
    | _, BNil -> Short
    end

  (* a subject segment whose full case fold is exactly [f]: rest after it *)
  let rec match_fold (rest : bytes) (n : int) (f : bytes) : dropped
    requires { n >= 0 } variant { n }
  = match f with
    | BNil -> Rest rest
    | _ ->
      if n = 0 then Short
      else match decode rest with
        | NoChar -> Short
        | Char c _ r ->
          match strip (fold_of c) f with
          | Rest f' -> match_fold r (n - 1) f'
          | Short -> Short
          end
        end
    end

  let rec fold_string (l : bytes) (n : int) (acc : bytes) : bytes
    requires { n >= 0 } variant { n }
  = if n = 0 then acc
    else match decode l with
      | NoChar -> acc
      | Char c _ r -> fold_string r (n - 1) (append acc (fold_of c))
      end

  let rec set_cap (k s e : int) (cs : caps) : caps variant { cs } =
    match cs with
    | CNil -> CCons k s e CNil
    | CCons k' s' e' t -> if k' = k then CCons k s e t else CCons k' s' e' (set_cap k s e t)
    end

  (* group k: [1; s; e] or [0] when unset (no option holding a list) *)
  type found = Unset | Found int int

  let rec lookup (k : int) (cs : caps) : found variant { cs } =
    match cs with
    | CNil -> Unset
    | CCons k' s e t -> if k = k' then Found s e else lookup k t
    end

  let eq_found (a b : found) : bool =
    match a, b with
    | Unset, Unset -> true
    | Found x y, Found x' y' -> x = x' && y = y'
    | _, _ -> false
    end

  let rec same_refs (refs : bytes) (a b : caps) : bool variant { refs } =
    match refs with
    | BNil -> true
    | BCons g t -> eq_found (lookup g a) (lookup g b) && same_refs t a b
    end

  (* start of the character before [pos], or -1 *)
  let rec prev_from (l : bytes) (i pos last : int) : int variant { l } =
    if i >= pos then last
    else match l with
      | BNil -> last
      | BCons b t -> prev_from t (i + 1) pos (if 128 <= b && b < 192 then last else i)
      end

  let prev_pos (s : bytes) (pos : int) : int = prev_from s 0 pos (-1)

  let word_at (rest : bytes) : bool =
    match decode rest with Char c _ _ -> in_prop 12 c | NoChar -> false end

  let word_before (s : bytes) (pos : int) : bool =
    let p = prev_pos s pos in p >= 0 && word_at (drop0 p s)

  let is_nl (l : bytes) : bool =
    match l with BCons b _ -> b = 10 | BNil -> false end

  let anchor_ok (s : bytes) (len : int) (a : anchor) (pos : int) (rest : bytes) : bool =
    match a with
    | BolA -> pos = 0 || is_nl (drop0 (pos - 1) s)
    | EolA -> pos = len || is_nl rest
    | BufBeg | SearchStart -> pos = 0
    | BufEnd -> pos = len
    | SemiEnd -> pos = len || (pos = len - 1 && is_nl rest)
    | WordB -> xorb (word_before s pos) (word_at rest)
    | NotWordB -> not (xorb (word_before s pos) (word_at rest))
    end

  let backtrack (bt : frames) : state =
    match bt with
    | FNil -> Failed
    | FCons its pos rest cs bt' -> Run its pos rest cs bt'
    end

  (* the next iteration of a loop, or leaving it *)
  let rep (mn mx : int) (g : bool) (a : node) (c : int)
          (k : items) (pos : int) (rest : bytes) (cs : caps) (bt : frames) : state =
    let again = ICons (INode a) (ICons (IIter mn mx g a (c + 1) pos cs) k) in
    if c < mn then Run again pos rest cs bt
    else if mx >= 0 && c >= mx then Run k pos rest cs bt
    else if g then Run again pos rest cs (FCons k pos rest cs bt)
    else Run k pos rest cs (FCons again pos rest cs bt)

  (* backreference: the groups in order, the first one set and matching *)
  let rec bref (s : bytes) (gs : bytes) (ic : bool) (cs : caps) (rest : bytes) : dropped
    variant { gs }
  = match gs with
    | BNil -> Short
    | BCons g t ->
      match lookup g cs with
      | Unset -> bref s t ic cs rest
      | Found x y ->
        let txt = take (y - x) (drop0 x s) in
        let r = if ic then match_fold rest (length rest) (fold_string txt (y - x) BNil)
                else prefix txt rest in
        match r with
        | Rest r' -> Rest r'
        | Short -> bref s t ic cs rest
        end
      end
    end

  let step (s : bytes) (len : int) (refs : bytes) (st : state) : state =
    match st with
    | Run its pos rest cs bt ->
      match its with
      | INil -> Matched pos cs
      | ICons (INode Eps) k -> Run k pos rest cs bt
      | ICons (INode (Lit l)) k ->
        match prefix l rest with
        | Rest r -> Run k (pos + length l) r cs bt
        | Short -> backtrack bt
        end
      | ICons (INode (LitI f)) k ->
        match match_fold rest (length rest) f with
        | Rest r -> Run k (len - length r) r cs bt
        | Short -> backtrack bt
        end
      | ICons (INode (Cls cl)) k ->
        match decode rest with
        | Char c l r -> if in_cset c cl then Run k (pos + l) r cs bt else backtrack bt
        | NoChar -> backtrack bt
        end
      | ICons (INode (ClsI cl ms)) k ->
        (* one character of the class first, then each folded string *)
        let rec alts (ms : folds) (bt : frames) : frames variant { ms } =
          match ms with
          | FsNil -> bt
          | FsCons m t ->
            match match_fold rest (length rest) m with
            | Rest r -> FCons k (len - length r) r cs (alts t bt)
            | Short -> alts t bt
            end
          end in
        let bt' = alts ms bt in
        match decode rest with
        | Char c l r -> if in_cset c cl then Run k (pos + l) r cs bt' else backtrack bt'
        | NoChar -> backtrack bt'
        end
      | ICons (INode (Cat a b)) k -> Run (ICons (INode a) (ICons (INode b) k)) pos rest cs bt
      | ICons (INode (Alt a b)) k ->
        Run (ICons (INode a) k) pos rest cs (FCons (ICons (INode b) k) pos rest cs bt)
      | ICons (INode (Rep mn mx g a)) k -> rep mn mx g a 0 k pos rest cs bt
      | ICons (IIter mn mx g a c p0 c0) k ->
        if c > mn && mx < 0 && pos = p0 && same_refs refs cs c0 then Run k pos rest cs bt
        else rep mn mx g a c k pos rest cs bt
      | ICons (INode (Atomic a)) k -> Run (ICons (INode a) (ICons (ICut bt) k)) pos rest cs bt
      | ICons (ICut bt0) k -> Run k pos rest cs bt0
      | ICons (INode (Ahead ng a)) k ->
        if ng then Run (ICons (INode a) (ICons (INegFail bt) k)) pos rest cs (FCons k pos rest cs bt)
        else Run (ICons (INode a) (ICons (ILookOk bt pos rest) k)) pos rest cs bt
      | ICons (ILookOk bt0 p r) k -> Run k p r cs bt0
      | ICons (INegFail bt0) _ -> backtrack bt0
      | ICons (INode (Behind ng alts)) k ->
        if ng then Run (ICons (IBTry alts pos pos) (ICons (INegFail bt) k)) pos rest cs
                       (FCons k pos rest cs bt)
        else Run (ICons (IBTry alts pos pos) (ICons (ILookOk bt pos rest) k)) pos rest cs bt
      | ICons (IBTry alts j i) k ->
        (* alternative [a] from [j] to [i]; then the next start, then the
           next alternative *)
        match alts with
        | NNil -> backtrack bt
        | NCons a t ->
          let p = prev_pos s j in
          let next = if p >= 0 then ICons (IBTry alts p i) k else ICons (IBTry t i i) k in
          Run (ICons (INode a) (ICons (IAtEnd i) k)) j (drop0 j s) cs (FCons next pos rest cs bt)
        end
      | ICons (IAtEnd i) k -> if pos = i then Run k pos rest cs bt else backtrack bt
      | ICons (INode (Group i a)) k -> Run (ICons (INode a) (ICons (IClose i pos) k)) pos rest cs bt
      | ICons (IClose i p0) k -> Run k pos rest (set_cap i p0 pos cs) bt
      | ICons (INode (Bref gs ic)) k ->
        match bref s gs ic cs rest with
        | Rest r -> Run k (len - length r) r cs bt
        | Short -> backtrack bt
        end
      | ICons (INode (Anc a)) k ->
        if anchor_ok s len a pos rest then Run k pos rest cs bt else backtrack bt
      end
    | _ -> st
    end

  let rec run (s : bytes) (len : int) (refs : bytes) (fuel : int) (st : state) : state
    requires { fuel >= 0 } variant { fuel }
  = if fuel = 0 then st
    else match st with
      | Run _ _ _ _ _ -> run s len refs (fuel - 1) (step s len refs st)
      | _ -> st
      end

  type result =
    | RMatch int int caps
    | RMismatch
    | RLimit

  let rec search_from (s : bytes) (len : int) (refs : bytes) (n fuel : int) (re : node)
                      (pos : int) (rest : bytes) : result
    requires { n >= 0 && fuel >= 0 } variant { n }
  = if n = 0 then RMismatch
    else match run s len refs fuel (Run (ICons (INode re) INil) pos rest CNil FNil) with
      | Matched e cs -> RMatch pos e cs
      | Run _ _ _ _ _ -> RLimit
      | Failed ->
        match rest with
        | BNil -> RMismatch
        | BCons b _ ->
          let l = enc_len b in
          match drop l rest with
          | Rest r -> search_from s len refs (n - 1) fuel re (pos + l) r
          | Short -> RMismatch
          end
        end
      end

  let search (fuel : int) (refs : bytes) (re : node) (s : bytes) : result
    requires { fuel >= 0 }
  = let len = length s in search_from s len refs (len + 1) fuel re 0 s

  let rec lookup_enc (k : int) (cs : caps) (acc : bytes) : bytes variant { cs } =
    match cs with
    | CNil -> BCons 0 acc
    | CCons k' s e t -> if k = k' then BCons 1 (BCons s (BCons e acc)) else lookup_enc k t acc
    end

  let rec groups (k : int) (cs : caps) (acc : bytes) : bytes variant { k } =
    if k < 1 then acc else groups (k - 1) cs (lookup_enc k cs acc)

  let encode (ncap : int) (r : result) : bytes =
    match r with
    | RMismatch -> BCons 0 BNil
    | RLimit -> BCons 2 BNil
    | RMatch s e cs -> BCons 1 (BCons s (BCons e (groups ncap cs BNil)))
    end

  let constant fuel0 : int = 10000000

  let run_case (fuel ncap : int) (refs : bytes) (re : node) (s : bytes) : bytes
    requires { fuel >= 0 }
  = encode ncap (search fuel refs re s)

  let rec eq_list (a b : bytes) : bool variant { a } =
    match a, b with
    | BNil, BNil -> true
    | BCons x a', BCons y b' -> x = y && eq_list a' b'
    | _, _ -> false
    end

  (* a case: groups, backreferenced groups, pattern, subject, expected *)
  type case = Case int bytes node bytes bytes

  let agree (fuel : int) (c : case) : bool
    requires { fuel >= 0 }
  = let Case ncap refs re s exp = c in eq_list (run_case fuel ncap refs re s) exp

end
