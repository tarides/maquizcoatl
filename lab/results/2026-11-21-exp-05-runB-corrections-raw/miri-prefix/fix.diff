+/// args.subject.as_ref(), a reference to one byte, which Miri's Stacked
+/// Borrows rejects when the slice reads past that byte (run B).
 unsafe fn subject_of(args: &VuArgs) -> &[u8] {
-    if args.subject_len < 0 {
