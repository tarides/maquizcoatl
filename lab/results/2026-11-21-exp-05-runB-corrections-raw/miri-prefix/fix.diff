-    let p = some(unsafe { args.subject.as_ref() });
-    unsafe { core::slice::from_raw_parts(p, args.subject_len as usize) }
+    unsafe { core::slice::from_raw_parts(args.subject, args.subject_len as usize) }
 }
 
